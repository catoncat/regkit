# <UPSTREAM>_* — your upstream prefix. All values live here, never in code.

# site + API prefix (the registration surface)
<UPSTREAM>_SITE_ORIGIN=https://api.example.com
<UPSTREAM>_API_PREFIX=/api/v1

# batch defaults
<UPSTREAM>_COUNT=1
<UPSTREAM>_WORKERS=1
<UPSTREAM>_DELAY_MS=1500

# mail polling (cloud-mail CLI contract)
MAILBOX_CLI=cloud-mail
<UPSTREAM>_MAIL_TIMEOUT=120
<UPSTREAM>_MAIL_POLL_INTERVAL=3

# optional fixed pool of catch-all domains (empty -> live discovery)
<UPSTREAM>_FIXED_POOL=

# signup pacing (AIMD; tune to the upstream's measured rate-limit shape)
<UPSTREAM>_SIGNUP_MIN_GAP_MS=3000
<UPSTREAM>_SIGNUP_START_GAP_MS=10000
<UPSTREAM>_SIGNUP_MAX_GAP_MS=120000

# gateway / watch
# The fleet gateway normally serves this project's accounts/usage files; the next two are for debugging only
<UPSTREAM>_EMBED_GATEWAY=0         # 1 = the watcher also serves this pool on GATEWAY_PORT
<UPSTREAM>_GATEWAY_PORT=48787
<UPSTREAM>_GATEWAY_KEY=            # static token clients must send ('' = no auth)
<UPSTREAM>_TARGET_USD=1000
<UPSTREAM>_SUPPLY_WORKERS=8
<UPSTREAM>_BALANCE_ROTATE_S=300
<UPSTREAM>_SUPPLY_CHECK_S=30
<UPSTREAM>_PRICE_IN=0.15           # $/M input tokens (gateway cost math)
<UPSTREAM>_PRICE_OUT=0.35          # $/M output tokens
